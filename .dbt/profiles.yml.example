dbt_test_project:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "ODBC Driver 17 for SQL Server"
      server: <HOST_NAME>
      # TU TRZEBA PODAĆ TĄ NOWĄ, WYEKSPORTOWANĄ BAZE
      database: AdventureWorks_dlt_dbt
      schema: Test
      windows_login: true
      encrypt: true
      trust_cert: true
